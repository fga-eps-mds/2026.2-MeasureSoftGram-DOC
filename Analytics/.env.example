# Copie este arquivo para .env (mesma pasta, Analytics/) e preencha.
# O .env nunca vai para o git.

# Zenhub > Settings (canto inferior esquerdo) > API > Generate new token
ZENHUB_TOKEN=cole_seu_token_aqui

# ID do workspace (já é o do MeasureSoftGram; só mude se trocar de workspace)
ZENHUB_WORKSPACE=6a8326e265e211000ef9379a

# Se der erro de SSL/TLS, force conexão direta (ignora proxy do sistema)
# ZENHUB_IGNORAR_PROXY=1
