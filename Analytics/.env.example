# Copie este arquivo para .env (mesma pasta, Analytics/) e preencha.
# O .env está no .gitignore e NUNCA vai para o git. Não cole a chave em código,
# issue, PR, print de tela ou log.

# Zenhub > Settings (canto inferior esquerdo) > API > Generate new token
# (ZENHUB_TOKEN, o nome antigo, continua aceito)
ZENHUB_API_KEY=cole_sua_chave_aqui

# ID do workspace (já é o do MeasureSoftGram; só mude se trocar de workspace)
ZENHUB_WORKSPACE_ID=6a8326e265e211000ef9379a

# Se der erro de SSL/TLS, force conexão direta (ignora proxy do sistema)
# ZENHUB_IGNORAR_PROXY=1

# SonarCloud (opcional: os projetos da organização são públicos). Só é preciso
# para projetos privados. My Account > Security > Generate Token.
# SONAR_TOKEN=cole_seu_token_aqui
